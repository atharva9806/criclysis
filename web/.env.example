# Postgres connection string. Locally: a Postgres 16 database you own.
# In production the web app uses the Neon pooled URL; the importer and
# migrations use the direct URL (advisory locks and DDL need it).
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/criclysis

# Shared secret for POST /api/revalidate (sent as the x-revalidate-secret header).
REVALIDATE_SECRET=
